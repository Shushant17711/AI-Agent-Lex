# Gemini (default provider). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Or any OpenAI-compatible endpoint:
# LEX_PROVIDER=openai
# LEX_MODEL=gpt-5-mini
# LEX_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=

# Ollama example (no key needed):
# LEX_PROVIDER=openai
# LEX_BASE_URL=http://localhost:11434/v1
# LEX_MODEL=qwen3-coder
